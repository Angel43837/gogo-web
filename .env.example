# Dominio público del sitio (canonical, sitemap, Open Graph).
# En Vercel se detecta solo; defínela solo si usas un dominio propio.
NEXT_PUBLIC_SITE_URL=

# Copia este archivo como `.env.local` y rellena los valores.
# La anon key de Supabase es pública por diseño (protegida por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App principal a la que se manda al usuario tras registrarse.
NEXT_PUBLIC_MAIN_APP_URL=
